{
	"name": "stations",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": "1.4.x"
	},
	"scripts": {
		"dev": "bun run --bun vite dev --host",
		"build": "bun run --bun vite build",
		"preview": "bun run --bun vite preview",
		"prepare": "bun run svelte-kit sync || echo ''",
		"check": "bun run svelte-kit sync && bun run svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "bun run svelte-kit sync && bun run svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"typecheck:ts7": "bun run svelte-kit sync && bun run tsc --project ./tsconfig.json --noEmit",
		"format": "bun run prettier --write .",
		"lint": "bun run prettier --check . && bun run eslint .",
		"test": "bun run vitest run",
		"test:watch": "bun run vitest",
		"test:e2e": "bun run playwright test",
		"verify:bun-image": "bun scripts/verify-bun-image.ts",
		"verify:bun-s3": "bun scripts/verify-bun-s3.ts",
		"verify:bun-auth": "bun scripts/verify-bun-auth.ts"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/fluent": "1.2.57",
		"@iconify-json/fluent-emoji": "1.2.7",
		"@iconify-json/heroicons": "1.2.3",
		"@iconify-json/logos": "1.2.13",
		"@iconify-json/material-symbols": "1.2.89",
		"@playwright/test": "1.62.1",
		"@stylexjs/unplugin": "^0.19.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/bun": "1.4.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vite-pwa/sveltekit": "1.1.0",
		"arctic": "3.7.0",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"leaflet": "1.9.4",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"sveaflet": "0.1.5",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"svelte-cookie-consent": "2.3.1",
		"sveltekit-superforms": "2.30.2",
		"typescript": "~6",
		"typescript-eslint": "8.68.0",
		"unplugin-icons": "23.0.1",
		"valibot": "1.4.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@boxfish-studio/sveltekit-cookie-manager": "1.0.3",
		"@iconify/svelte": "5.2.2",
		"@stylexjs/stylex": "^0.19.0",
		"dotenv": "17.4.2",
		"layerchart": "^2.3.0"
	}
}
